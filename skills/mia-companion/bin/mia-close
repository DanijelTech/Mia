#!/bin/sh
# mia-close [url-part|domain|all]... — close window(s) Mia opened with mia-open,
# by their recorded window ids (graceful close, like clicking the X).
# Several patterns may be given; a window matches when its URL contains any of
# them. If no registered window matches, visible browser windows whose *title*
# contains a pattern are closed as well — that is how windows opened by
# xdg-open (or by a Mia older than the registry) get closed.
REG="$HOME/.cache/mia-windows"
[ $# -gt 0 ] || { echo "usage: mia-close <url-prefix|all> [...]" >&2; exit 2; }
if ! command -v xdotool >/dev/null 2>&1; then
  echo "mia-close: xdotool is not installed — cannot close windows (install xdotool)" >&2
  exit 3
fi

audit_close() {
  command -v python3 >/dev/null 2>&1 || return 0
  state="${XDG_STATE_HOME:-$HOME/.local/state}/mia"
  mkdir -p "$state" 2>/dev/null || return 0
  python3 -c 'import json,os,socket,sys,time; print(json.dumps({"ts":time.time(),"action":"close","args":sys.argv[1:],"ok":True,"rc":0,"ms":0,"error":"","summary":"closed","host":socket.gethostname(),"user":os.environ.get("USER",""),"cwd":os.getcwd(),"desktop":os.environ.get("XDG_SESSION_TYPE","")}))' "$@" >> "$state/control-audit.jsonl" 2>/dev/null || true
}

ALL=0
for a in "$@"; do [ "$a" = "all" ] && ALL=1; done
closed=0

matches_url() { # matches_url <url> <pattern>...
  u="$1"; shift
  [ "$ALL" = 1 ] && return 0
  for p in "$@"; do
    case "$u" in *"$p"*) return 0 ;; esac
  done
  return 1
}

if [ -f "$REG" ]; then
  tmp="$REG.tmp"; : > "$tmp"
  while IFS='	' read -r w u; do
    [ -z "$w" ] && continue
    if matches_url "$u" "$@"; then
      if xdotool windowclose "$w" 2>/dev/null; then
        echo "closed: $u"
        closed=$((closed + 1))
      else
        # keep it: a transient failure must not lose the only handle we have
        printf '%s\t%s\n' "$w" "$u" >> "$tmp"
      fi
    else
      xdotool getwindowname "$w" >/dev/null 2>&1 && printf '%s\t%s\n' "$w" "$u" >> "$tmp"
    fi
  done < "$REG"
  mv "$tmp" "$REG"
else
  echo "registry empty ($REG)"
fi

close_by_title() { # close_by_title <pattern>... — browser windows only
  [ "$ALL" = 1 ] && return 0
  for p in "$@"; do
    lp=$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')
    for w in $(xdotool search --onlyvisible --name '.*' 2>/dev/null); do
      case "$w" in ''|*[!0-9]*) continue ;; esac
      name=$(xdotool getwindowname "$w" 2>/dev/null | tr '[:upper:]' '[:lower:]')
      case "$name" in *"$lp"*) ;; *) continue ;; esac
      cls=$(xdotool getwindowclassname "$w" 2>/dev/null | tr '[:upper:]' '[:lower:]')
      case "$cls" in
        *chrom*|*brave*|*firefox*|*edge*|*vivaldi*|*opera*)
          if xdotool windowclose "$w" 2>/dev/null; then
            echo "closed: $p (okno $w)"
            closed=$((closed + 1))
          fi
          ;;
      esac
    done
  done
}

[ "$closed" -eq 0 ] && close_by_title "$@"

audit_close "$@"
[ "$closed" -eq 0 ] && echo "nothing to close for: $*"
exit 0
