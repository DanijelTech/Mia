#!/bin/sh
# mia-close [url-part|domain|all] — close window(s) Mia opened with mia-open,
# by their recorded window ids (graceful close, like clicking the X).
# The pattern matches anywhere in the URL, so a bare domain works.
REG="$HOME/.cache/mia-windows"
pat="$1"
[ -z "$pat" ] && { echo "usage: mia-close <url-prefix|all>" >&2; exit 2; }

audit_close() {
  command -v python3 >/dev/null 2>&1 || return 0
  state="${XDG_STATE_HOME:-$HOME/.local/state}/mia"
  mkdir -p "$state" 2>/dev/null || return 0
  python3 -c 'import json,os,socket,sys,time; print(json.dumps({"ts":time.time(),"action":"close","args":[sys.argv[1]],"ok":True,"rc":0,"ms":0,"error":"","summary":"closed","host":socket.gethostname(),"user":os.environ.get("USER",""),"cwd":os.getcwd(),"desktop":os.environ.get("XDG_SESSION_TYPE","")}))' "$1" >> "$state/control-audit.jsonl" 2>/dev/null || true
}
[ "$pat" = "all" ] && pat=""
[ -f "$REG" ] || { echo "nothing to close (registry empty)"; exit 0; }

closed=0; tmp="$REG.tmp"; : > "$tmp"
while IFS='	' read -r w u; do
    [ -z "$w" ] && continue
    case "$u" in
        *"$pat"*)
            if xdotool windowclose "$w" 2>/dev/null; then
                echo "closed: $u"
                closed=$((closed + 1))
            fi
            ;;
        *)
            xdotool getwindowname "$w" >/dev/null 2>&1 && printf '%s\t%s\n' "$w" "$u" >> "$tmp"
            ;;
    esac
done < "$REG"
mv "$tmp" "$REG"
audit_close "${pat:-all}"
[ "$closed" -eq 0 ] && echo "nothing to close for: ${pat:-all}"
exit 0
